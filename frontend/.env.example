# ==============================================================================
# DataGhost Frontend Configuration
# ==============================================================================

# Backend API URL:
# Mode A (Recommended - Single Dev Tunnel on Port 3000):
# Leave NEXT_PUBLIC_API_URL empty or unset. Next.js automatically rewrites /api/*
# to http://127.0.0.1:8000 on the host PC. Works on localhost AND mobile dev tunnel seamlessly!
# NEXT_PUBLIC_API_URL=
#
# Mode B (Dual Dev Tunnel - Separate Port 3000 and 8000 Tunnels):
# Set this to your backend's port 8000 Dev Tunnel URL:
# NEXT_PUBLIC_API_URL=https://<your-backend-tunnel-id>.devtunnels.ms
#
# Mode C (Direct localhost on desktop only):
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Client Configuration (Optional for Firebase Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
