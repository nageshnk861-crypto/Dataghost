an_summary_get","security":[{"HTTPBearer":[]}],"parameters":[{"name":"device_id_or_id","in":"path","required":true,"schema":{"type":"string","title":"Device Id Or Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceScanSummaryResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/devices/{device_id_or_id}/scan":{"post":{"tags":["devices"],"summary":"Trigger Device Scan","description":"Trigger a DLP security scan on the specified endpoint device.\nDynamically scans real files from the host filesystem or custom endpoint payloads,\nevaluates sensitive findings via DLP regex patterns and the ML classifier,\npersists findings to the database with redacted evidence, and returns summary\ncomputed strictly from persisted records.","operationId":"trigger_device_scan_api_v1_devices__device_id_or_id__scan_post","security":[{"HTTPBearer":[]}],"parameters":[{"name":"device_id_or_id","in":"path","required":true,"schema":{"type":"string","title":"Device Id Or Id"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/DeviceScanTriggerRequest"},{"type":"null"}],"title":"Payload"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeviceScanSummaryResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/devices/register":{"post":{"tags":["devices"],"summary":"Register Device Legacy","description":"Legacy registration endpoint for backwards compatibility with existing agents.\nRequires authentication. Only an admin or the owning user may upsert a device record.\nUpserts by device_id.","operationId":"register_device_legacy_api_v1_devices_register_post","requestBody":{"conten