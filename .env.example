# ==============================================================================
# DataGhost - Root Environment Example
# ==============================================================================

# Backend Configuration
DATABASE_URL=sqlite:///./dataghost.db
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Server Public URL (for device enrollment QR codes / mobile agents)
# Local: http://localhost:8000
# Remote Dev Tunnel: https://<backend-tunnel-id>.devtunnels.ms
SERVER_PUBLIC_URL=http://localhost:8000

# CORS Configuration
# Include your frontend Dev Tunnel URL if accessing via two separate tunnels
FRONTEND_URL=http://localhost:3000
TUNNEL_FRONTEND_URL=https://<frontend-tunnel-id>.devtunnels.ms
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# Frontend Configuration
# NEXT_PUBLIC_API_URL:
# - Leave empty to use automatic Next.js API proxy (single tunnel on port 3000)
# - Set to backend Dev Tunnel URL if exposing ports 3000 and 8000 separately
NEXT_PUBLIC_API_URL=http://localhost:8000