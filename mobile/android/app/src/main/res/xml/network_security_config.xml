<?xml version="1.0" encoding="utf-8"?>
<!--
  DataGhost Android Enterprise Agent – Network Security Config.

  Allows cleartext HTTP traffic to localhost and LAN IPs during development.
  In production, only HTTPS is allowed for all DataGhost server communication.
-->
<network-security-config>
    <!-- Production: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development: allow cleartext to localhost and private IPs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <!-- Dev tunnels always use HTTPS, so no entry needed -->
    </domain-config>
</network-security-config>
