DATABASE_URL=sqlite:///./dataghost.db
REDIS_URL=redis://localhost:6379
SECRET_KEY=supersecretkey-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Server URL (used in device enrollment QR payloads)
# For local desktop: http://localhost:8000
# For mobile/devtunnel: https://<your-backend-tunnel-id>.devtunnels.ms
SERVER_PUBLIC_URL=http://localhost:8000

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000
# Set TUNNEL_FRONTEND_URL if your frontend runs on a custom domain/tunnel:
# TUNNEL_FRONTEND_URL=https://<your-frontend-tunnel-id>.devtunnels.ms

# Allowed CORS Origins (JSON array or comma-separated string)
# Default already includes: http://localhost:3000, http://127.0.0.1:3000, http://localhost:8000, http://127.0.0.1:8000
# Note: Any https://*.devtunnels.ms origin is also automatically matched by regex
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_PROJECT_ID=dataghost-9431f
